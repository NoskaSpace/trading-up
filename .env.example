# FastAPI 서비스 포트 설정
APP_PORT=8000

# 관리자 인증 기본값
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# JWT 서명 및 만료 시간 설정
AUTH_SECRET_KEY=change-this-secret
TOKEN_EXPIRE_MINUTES=60

# Telegram 봇 연동 정보 (필수 토큰, 선택 채팅 ID)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=

# 한국투자증권(KIS) API 자격 증명 (필수: 앱 키, 시크릿, 계좌번호)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_TYPE=
